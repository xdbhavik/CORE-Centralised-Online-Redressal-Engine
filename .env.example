# Docker Compose environment file
# Copy to `.env` in the repo root and fill in real values.

# ---- MySQL ----
DB_PASSWORD=root

# ---- JWT (REQUIRED for non-local) ----
JWT_SECRET=

# ---- AI: NVIDIA NIM ----
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-nano-8b-instruct

# ---- AI: Sarvam STT/TTS ----
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai

# ---- AI: Sarvam Voice (outbound IVR) ----
SARVAM_VOICE_API_KEY=
SARVAM_VOICE_BASE_URL=https://apps.sarvam.ai
SARVAM_VOICE_ORG_ID=
SARVAM_VOICE_WORKSPACE_ID=
SARVAM_VOICE_APP_ID=
SARVAM_VOICE_CONNECTION_ID=
SARVAM_VOICE_AGENT_PHONE_NUMBER=
SARVAM_VOICE_WEBHOOK_SECRET=
SARVAM_VOICE_ENABLED=false

# ---- IVR ----
IVR_ENABLED=false
IVR_BASE_PUBLIC_URL=http://localhost:8080

# ---- Firebase ----
FIREBASE_ENABLED=true
FIREBASE_DEV_MOCK_ENABLED=true
APP_DEV_MOCK_OTP_ENABLED=false

# ---- App ----
APP_PUBLIC_URL=http://localhost
SMS_ENABLED=false
QDRANT_API_KEY=
