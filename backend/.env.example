# ==========================================================================
# Environment variables for the AI Based Grievance System backend.
# Copy this file to `.env` and fill in real values (or export them in your
# shell / set them in Docker). Spring Boot reads these through the
# ${ENV_VAR:default} placeholders in src/main/resources/application.properties.
#
# Every credential below has an EMPTY default in application.properties, so
# real secrets must be supplied here and never committed to git.
# ==========================================================================

# ---------------- Database (MySQL) ----------------
DB_URL=jdbc:mysql://localhost:3306/grievance_system?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
DB_USERNAME=root
DB_PASSWORD=root

# ---------------- Server ----------------
SERVER_PORT=8080
# Public URL of this app (used as the HTTP-Referer header for the LLM API).
APP_PUBLIC_URL=http://localhost:8080
# Directory where complaint media / IVR audio is stored.
APP_UPLOAD_DIR=uploads

# ---------------- JWT ----------------
# HS256 requires >= 32 bytes. Generate a strong value for anything non-local.
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION_MILLIS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MILLIS=1209600000

# ---------------- AI — NVIDIA NIM (chat / classification / summarisation) ----------------
AI_CHAT_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-nano-8b-instruct

# ---------------- Sarvam AI — STT / Translation / TTS (api.sarvam.ai) ----------------
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_API_KEY=

# ---------------- Qdrant Vector Database ----------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ---------------- Firebase Phone Auth ----------------
FIREBASE_ENABLED=true
FIREBASE_WEB_API_KEY=
# DEV ONLY — set to false in production.
FIREBASE_DEV_MOCK_ENABLED=true
# Dev-only mock OTP endpoints (/api/v1/otp/*). Keep false in production.
APP_DEV_MOCK_OTP_ENABLED=false

# ---------------- IVR — citizen call-back verification ----------------
IVR_ENABLED=false
# Sarvam reaches us on a public URL (ngrok tunnel in dev).
IVR_BASE_PUBLIC_URL=http://localhost:8080
IVR_VALIDATE_SIGNATURE=true

# ---------------- Sarvam AI Voice Agents — outbound calls (apps.sarvam.ai) ----------------
SARVAM_VOICE_ENABLED=false
SARVAM_VOICE_BASE_URL=https://apps.sarvam.ai
SARVAM_VOICE_API_KEY=
SARVAM_VOICE_ORG_ID=
SARVAM_VOICE_WORKSPACE_ID=
SARVAM_VOICE_APP_ID=
SARVAM_VOICE_APP_VERSION=1
SARVAM_VOICE_CONNECTION_ID=
SARVAM_VOICE_AGENT_PHONE_NUMBER=
SARVAM_VOICE_WEBHOOK_SECRET=
SARVAM_VOICE_RESULT_VARIABLE=verification_result
SARVAM_VOICE_CONFIRMED_VALUE=confirmed
SARVAM_VOICE_DENIED_VALUE=denied

# ---------------- SMS ----------------
SMS_ENABLED=false
